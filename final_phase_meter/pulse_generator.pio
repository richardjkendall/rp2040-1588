;
; CPU-Controlled Pulse Generator (v3 - Hybrid FLL+PLL)
;
; This program generates a precise pulse by actively driving the pin
; HIGH and LOW for durations provided by the CPU. It also includes
; a hard phase reset mechanism triggered by the GPS 1PPS pin.
;
; The CPU must push two 32-bit words for each full cycle:
; 1. The number of cycles to hold the pin HIGH.
; 2. The number of cycles to hold the pin LOW.
;

.program pulse_generator

start_of_program: ; Label for the beginning of the pulse generation cycle
.wrap_target
    ; --- HIGH Phase ---
    pull block      ; Get HIGH duration from CPU
    mov y, osr      ; Use 'y' for the HIGH phase counter
    set pins, 1     ; Drive output pin HIGH
high_loop:
    jmp y--, high_loop

    ; --- LOW Phase ---
    pull block      ; Get LOW duration from CPU
    mov x, osr      ; Use 'x' for the LOW phase counter
    set pins, 0     ; Drive output pin LOW
low_loop:
    jmp pin, start_of_program ; If GPS pin is HIGH, abort delay and reset cycle.
                              ; GPS_1PPS_PIN is configured as jmp pin.
    jmp x--, low_loop
.wrap
