/**
 * lwIP Configuration for PTP Grandmaster
 *
 * Minimal overrides for PTP multicast support.
 * Uses Pico SDK defaults for threading (pico_cyw43_arch_lwip_threadsafe_background).
 */

#ifndef _LWIPOPTS_H
#define _LWIPOPTS_H

// Don't have legacy 1.3.2 options
#define LWIP_NOASSERT 1
#define NO_SYS 1  // No RTOS - use polling mode
#define LWIP_SOCKET 0  // Using raw API, not sockets
#define LWIP_NETCONN 0  // Disable Sequential API (requires NO_SYS=0)

// Memory settings
#define MEM_SIZE 4000
#define MEMP_NUM_TCP_PCB 5
#define MEMP_NUM_TCP_PCB_LISTEN 4
#define MEMP_NUM_TCP_SEG 16
#define MEMP_NUM_UDP_PCB 8  // Increased for PTP
#define MEMP_NUM_IGMP_GROUP 4
#define PBUF_POOL_SIZE 12

// TCP settings
#define TCP_MSS 536
#define TCP_SND_BUF (4 * TCP_MSS)
#define TCP_WND (4 * TCP_MSS)

// PTP requires multicast
#define LWIP_IGMP 1
#define LWIP_MULTICAST_TX_OPTIONS 1

// Enable needed protocols
#define LWIP_ARP 1
#define LWIP_ETHERNET 1
#define LWIP_ICMP 1
#define LWIP_RAW 1
#define LWIP_DHCP 1
#define LWIP_DNS 1
#define LWIP_UDP 1
#define LWIP_TCP 1

// DHCP
#define LWIP_DHCP_CHECK_LINK_UP 1

// Disable stats and debug for minimal overhead
#define LWIP_STATS 0
#define LWIP_DEBUG 0

#endif /* _LWIPOPTS_H */
