; GPS Disciplined Clock - PIO Programs
; Two state machines working together for precision GPS discipline
;
; SM0: Free-running 250 MHz counter (4ns resolution)
; SM1: GPS PPS edge detector with atomic counter snapshot

; ============================================================================
; SM0: Free-Running Counter at CPU Speed
; ============================================================================
; Runs at 250 MHz (no clock divider) for maximum precision
; Counts DOWN from 0xFFFFFFFF to 0, wraps every ~17 seconds
; Continuously pushes counter value to TX FIFO for DMA distribution

.program free_counter_250mhz

.wrap_target
loop:
    mov isr, x          ; Copy counter to ISR
    push noblock        ; Push to TX FIFO (non-blocking for continuous flow)
    jmp x--, loop       ; Decrement X, jump back to loop if X was non-zero
    ; When X == 0, falls through to wrap (X becomes 0xFFFFFFFF again)
.wrap

% c-sdk {
#include "hardware/pio.h"
#include "hardware/clocks.h"

static inline void free_counter_250mhz_program_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = free_counter_250mhz_program_get_default_config(offset);

    // NO clock divider - run at full CPU speed (250 MHz)
    // This gives us 4ns resolution
    sm_config_set_clkdiv(&c, 1.0f);

    // Configure autopush for TX FIFO
    sm_config_set_out_shift(&c, false, false, 32);
    sm_config_set_in_shift(&c, false, false, 32);

    // Initialize state machine
    pio_sm_init(pio, sm, offset, &c);

    // Initialize X register to 0xFFFFFFFF (start of countdown)
    // Use "mov x, !null" encoded with invert bit
    pio_sm_exec(pio, sm, pio_encode_mov(pio_x, pio_null) | 0x0008);

    // Start state machine
    pio_sm_set_enabled(pio, sm, true);
}
%}


; ============================================================================
; SM1: GPS PPS Edge Detector with Counter Snapshot
; ============================================================================
; Receives counter values from SM0 via DMA (to RX FIFO / OSR)
; On GPS PPS rising edge, captures exact counter value
; Pushes snapshot to TX FIFO and triggers IRQ for CPU

.program pps_edge_capture

.wrap_target
    pull noblock        ; Get latest counter from DMA (to OSR)
    mov y, osr          ; Store counter in Y register
    wait 0 gpio 2       ; Wait for GPS PPS to be low (ensure clean edge)
    wait 1 gpio 2       ; Wait for GPS PPS rising edge
    mov isr, y          ; Snapshot! Copy counter to ISR
    push block          ; Push to TX FIFO (blocking - wait for CPU to read)
    irq 0               ; Trigger CPU interrupt
.wrap

% c-sdk {
#include "hardware/pio.h"
#include "hardware/gpio.h"

static inline void pps_edge_capture_program_init(PIO pio, uint sm, uint offset, uint pps_pin) {
    pio_sm_config c = pps_edge_capture_program_get_default_config(offset);

    // NO clock divider - run at full CPU speed to minimize latency
    sm_config_set_clkdiv(&c, 1.0f);

    // Configure autopull: DMA writes to RX FIFO → auto-pulled to OSR
    sm_config_set_out_shift(&c, false, true, 32);  // Autopull enabled
    sm_config_set_in_shift(&c, false, false, 32);

    // Configure wait instruction to monitor PPS pin
    sm_config_set_jmp_pin(&c, pps_pin);  // For jmp pin instruction if needed

    // Initialize state machine
    pio_sm_init(pio, sm, offset, &c);

    // Ensure PPS pin is input
    pio_gpio_init(pio, pps_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pps_pin, 1, false);  // Input

    // Start state machine
    pio_sm_set_enabled(pio, sm, true);
}
%}
