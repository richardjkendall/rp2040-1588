;
; Sub-Microsecond Timestamping PIO Program
;
; Captures a timestamp for an event on an input pin and pushes it to the
; RX FIFO as three 32-bit words:
;   1. Coarse Timestamp (whole microseconds from 'systimer')
;   2. Fine Timestamp (count of 8ns ticks until the next µs boundary)
;   3. Source ID (a pre-configured unique identifier)
;
; This program requires a 'microsecond strobe' signal on a second input
; pin, which is a pulse train with a 1µs period, generated by a hardware
; timer.
;

.program sub_us_timestamp
.wrap_target
    ; Phase 1: Wait for the external PPS event on pin 0
    wait 1 pin 0

    ; --- Begin Atomic Capture Sequence ---

    ; Phase 2: Capture and push the COARSE timestamp (whole microseconds)
    in systimer, 32
    push

    ; Phase 3: Measure time until the NEXT microsecond boundary
    mov x, 0      ; Reset counter register X
count_loop:
    jmp x++, count_loop [30] ; Fast, 1-cycle increment loop.
                            ; The [30] delay adds robustness, preventing a
                            ; runaway loop if a strobe is somehow missed.
    wait 1 pin 1  ; Stall until the µs Strobe pin (pin 1) goes high.

    ; Phase 4: Capture and push the FINE timestamp
    mov isr, x    ; Move fine count to ISR
    push

    ; Phase 5: Push the pre-configured Source ID
    mov isr, osr  ; OSR must be pre-loaded with the ID
    push

    ; --- End Atomic Capture Sequence ---

    ; Phase 6: Wait for the strobe to go low to prevent re-triggering
    ; on the same strobe pulse.
    wait 0 pin 1
.wrap

