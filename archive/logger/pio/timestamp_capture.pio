;
; PPS Event Capture for CPU Timestamping
;
; This PIO program simply detects a rising edge on an input pin
; and pushes a dummy value to its RX FIFO. The CPU will then
; timestamp this event upon DMA transfer.
;
; Uses 'pin 0' as the input for the PPS signal.
;

.program pps_capture_event
.wrap_target
    wait 0 pin 0        ; Wait for low
    wait 1 pin 0        ; Wait for rising edge
    push                ; Push a dummy value to RX FIFO
.wrap